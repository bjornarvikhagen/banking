{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "console": "readonly",
    "process": "readonly",
    "setTimeout": "readonly",
    "fetch": "readonly",
    "Headers": "readonly",
    "URLSearchParams": "readonly"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "restriction": "error",
    "style": "error",
    "perf": "error",
    "pedantic": "error",
    "nursery": "error"
  },
  "rules": {
    "eslint/no-unused-vars": "error",
    "eslint/eqeqeq": ["error", "always"],
    "eslint/no-implicit-globals": "error",
    "eslint/no-implied-eval": "error",
    "eslint/no-return-await": "error",
    "eslint/no-shadow": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/strict": ["error", "global"],
    "eslint/no-console": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/id-length": "off",
    "eslint/sort-keys": "off",
    "eslint/func-style": "off",
    "eslint/curly": ["error", "all"],
    "eslint/require-await": "off",
    "eslint/class-methods-use-this": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript-eslint/consistent-type-definitions": ["error", "interface"],
    "typescript-eslint/explicit-function-return-type": "error",
    "typescript-eslint/explicit-module-boundary-types": "error",
    "eslint-plugin-unicorn/prefer-string-replace-all": "error",
    "eslint-plugin-unicorn/explicit-length-check": "error",
    "eslint-plugin-unicorn/catch-error-name": "error",
    "eslint-plugin-unicorn/no-null": "off",
    "eslint-plugin-unicorn/text-encoding-identifier-case": "off",
    "eslint-plugin-unicorn/no-unreadable-array-destructuring": "off",
    "eslint-plugin-unicorn/no-await-expression-member": "error",
    "typescript-eslint/no-floating-promises": "error",
    "eslint/no-loss-of-precision": "error"
  }
}
